{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".bun-version"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "env.local", "env.prod", "env.preview", ".env*"],
      "outputs": ["dist/**"],
      "env": ["STARTER_ENV", "CLOUDFLARE_ENV", "SENTRY_ORG", "SENTRY_PROJECT"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/routeTree.gen.ts",
        ".cloudflare/types/**",
        "src/paraglide/**/*.d.ts",
        "!src/paraglide/.gitignore",
        "!project.inlang/.gitignore"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    },
    "build:ci": {
      "dependsOn": ["^build:ci"],
      "inputs": ["$TURBO_DEFAULT$", "!src/paraglide/**", "!project.inlang/.gitignore"],
      "outputs": [".cloudflare/types/**", "src/routeTree.gen.ts", "src/paraglide/**"],
      "env": [
        "CI",
        "CF_SEND_TELEMETRY",
        "GOOGLE_ENABLED",
        "TURNSTILE_ENABLED",
        "PAYMENTS_ENABLED",
        "STORAGE_ENABLED",
        "EMAIL_ENABLED"
      ]
    }
  }
}
