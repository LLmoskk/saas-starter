{
  "name": "saas-starter",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter admin dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:push": "pnpm --dir packages/db db:push",
    "db:studio": "pnpm --dir packages/db db:studio",
    "db:start": "pnpm --dir packages/db db:start",
    "db:stop": "pnpm --dir packages/db db:stop",
    "check": "oxlint && oxfmt --check"
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vercel": "^59.11.7"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.26.0"
}
