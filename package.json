{
  "name": "saas-starter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "sites/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter site-demo --filter admin dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --dir packages/db db:generate",
    "check": "oxlint && node scripts/check-architecture.mjs && pnpm check:i18n && oxfmt --check",
    "deploy:prod": "node scripts/cloudflare.mjs deploy prod",
    "setup:github": "node scripts/setup-github.mjs",
    "deploy:setup": "pnpm --dir sites/demo exec wrangler login",
    "check:i18n": "node scripts/check-i18n.mjs",
    "messages": "pnpm --filter './sites/*' exec paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy url cookie baseLocale",
    "setup:local": "node scripts/setup-local.mjs",
    "prepare": "node scripts/setup-local.mjs",
    "env:check": "tsx scripts/check-env.ts"
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.26.0"
}
