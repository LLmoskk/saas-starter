{
  "name": "saas-starter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter admin dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:push": "pnpm --dir packages/db db:push",
    "db:studio": "pnpm --dir packages/db db:studio",
    "db:start": "pnpm --dir packages/db db:start",
    "db:stop": "pnpm --dir packages/db db:stop",
    "check": "oxlint && node scripts/check-architecture.mjs && pnpm check:i18n && oxfmt --check",
    "env:production": "node scripts/cloudflare.mjs sync prod",
    "env:preview": "node scripts/cloudflare.mjs sync preview",
    "deploy:prod": "node scripts/cloudflare.mjs deploy prod",
    "deploy:preview": "node scripts/cloudflare.mjs deploy preview",
    "db:push:prod": "STARTER_ENV=prod pnpm db:push",
    "db:push:preview": "STARTER_ENV=preview pnpm db:push",
    "deploy:setup": "pnpm --dir apps/web exec cf auth login",
    "setup:github": "node scripts/setup-github.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "messages": "pnpm --dir apps/web exec paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy url cookie baseLocale",
    "setup:local": "node scripts/setup-local.mjs",
    "prepare": "node scripts/setup-local.mjs",
    "env:check": "tsx scripts/check-env.ts"
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.26.0"
}
