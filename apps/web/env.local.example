PAYMENTS_ENABLED=false
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=
WAFFO_SUCCESS_URL=
WAFFO_ENVIRONMENT=test
WAFFO_PRODUCTS=
STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
EMAIL_ENABLED=false
