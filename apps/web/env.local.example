# Copy to apps/web/env.local. Configure your database and authentication first.
DATABASE_URL=postgres://postgres:{password}@localhost:5433/starter
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
ADMIN_EMAILS=you@example.com
ADMIN_BETTER_AUTH_URL=http://localhost:3002
ADMIN_BETTER_AUTH_SECRET=replace-with-another-random-secret-at-least-32-characters
ADMIN_DEV_EMAIL=you@example.com

# false disables a service; true requires complete configuration.
# Remove a flag to infer activation from existing configuration.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
