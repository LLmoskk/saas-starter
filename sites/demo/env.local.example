# Copy to sites/demo/env.local. D1 and R2 use local Worker bindings.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
VITE_SITE_URL=http://localhost:3001
VITE_SITE_NAME=AI Video Demo
GOOGLE_ENABLED=false
TURNSTILE_ENABLED=false
PAYMENTS_ENABLED=false
STORAGE_ENABLED=false
EMAIL_ENABLED=false
# Set all three only after selecting a yir image-to-video model and its quoted cost ceiling.
YIR_API_KEY=
YIR_VIDEO_MODEL=
YIR_VIDEO_MAX_COST=
SITE_ADMIN_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
